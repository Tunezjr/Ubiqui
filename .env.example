# ---- Monad network ----
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_EXPLORER=https://testnet.monadexplorer.com

# ---- Wallet ----
# 0x-prefixed hex private key.
WALLET_PRIVATE_KEY=

# ---- Tokens & DEX ----
WMON_ADDRESS=0x760AfE86e5de5fa0Ee542fc7B7B713e1c5425701
ROUTER_ADDRESS=0xfB8e1C3b833f9E67a71C859a132cf783b645e436
FACTORY_ADDRESS=0x733e88f248b742db6c14c0b1713af5ad7fdd59d0

# ---- Trading ----
DEFAULT_BUY_MON=0.5
SLIPPAGE_BPS=150
MAX_PRIORITY_FEE_GWEI=2
GAS_LIMIT=450000

# ---- Risk ----
MAX_POSITIONS=5
STOP_LOSS_PCT=25
TAKE_PROFIT_PCT=80
TRAILING_STOP_PCT=15
MAX_DAILY_LOSS_MON=5

# ---- Scanner ----
MIN_LIQUIDITY_MON=25
MAX_BUY_TAX_BPS=500
HONEYPOT_CHECK=true
# Cap blocks per cron tick so we always finish inside Vercel's maxDuration.
MAX_BLOCKS_PER_TICK=2000

# ---- Copy trade ----
COPY_WALLETS=

# ---- Telegram ----
# @BotFather token.
TELEGRAM_BOT_TOKEN=
# Only messages from this chat id are accepted.
TELEGRAM_CHAT_ID=
# Random string; set when you call /api/setup. Telegram will send it back
# as X-Telegram-Bot-Api-Secret-Token so we can verify the webhook.
TELEGRAM_WEBHOOK_SECRET=

# ---- Vercel ----
# Vercel sets CRON_SECRET automatically for cron runs; we validate it.
# If running cron manually, set it yourself and pass as Authorization: Bearer ...
CRON_SECRET=

# ---- Upstash Redis (state) ----
# Attach the Upstash integration on Vercel and these are populated
# automatically as KV_REST_API_URL / KV_REST_API_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Runtime ----
DRY_RUN=true
LOG_LEVEL=info
