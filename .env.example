# ---- Monad network ----
# Monad testnet defaults. Override for mainnet once live.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_WS_URL=wss://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_EXPLORER=https://testnet.monadexplorer.com

# ---- Wallet ----
# 0x-prefixed hex private key. Keep this out of git.
WALLET_PRIVATE_KEY=

# ---- Tokens & DEX ----
# Wrapped MON and the default router. These are the addresses used by the
# majority of Uniswap V2-style forks deployed on Monad testnet; update them
# for your chosen DEX.
WMON_ADDRESS=0x760AfE86e5de5fa0Ee542fc7B7B713e1c5425701
ROUTER_ADDRESS=0xfB8e1C3b833f9E67a71C859a132cf783b645e436
FACTORY_ADDRESS=0x733e88f248b742db6c14c0b1713af5ad7fdd59d0

# ---- Trading ----
DEFAULT_BUY_MON=0.5
SLIPPAGE_BPS=150
MAX_PRIORITY_FEE_GWEI=2
GAS_LIMIT=450000

# ---- Risk ----
MAX_POSITIONS=5
STOP_LOSS_PCT=25
TAKE_PROFIT_PCT=80
TRAILING_STOP_PCT=15
MAX_DAILY_LOSS_MON=5

# ---- Scanner ----
SCAN_NEW_PAIRS=true
MIN_LIQUIDITY_MON=25
MAX_BUY_TAX_BPS=500
HONEYPOT_CHECK=true

# ---- Copy trade ----
# Comma-separated list of wallet addresses to mirror.
COPY_WALLETS=

# ---- Notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Runtime ----
LOG_LEVEL=info
DRY_RUN=true
